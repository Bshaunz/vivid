# Copy to .env (gitignored). Never commit real values.
DEV_MODE=true
DATABASE_URL=sqlite:///./vivid_dev.db

# Production frontend origin — exact match, no wildcard (§3.1)
FRONTEND_ORIGIN=http://localhost:5173

# Supabase JWT verification (required when DEV_MODE=false)
SUPABASE_JWT_SECRET=

# Claude API (step 10). Key name only — value stays out of the repo forever.
ANTHROPIC_API_KEY=
# Absolute path to the private synthesis system prompt file (§3.2)
SYNTHESIS_PROMPT_PATH=

# AI cost controls (§3.4)
MAX_MONTHLY_TOKENS=2000000
DAILY_TOKEN_BUDGET_PER_USER=60000
