# Frontend production build config (Vite), loaded automatically by `vite build`.
# COMMITTED on purpose: it holds only the PUBLIC backend URL that gets baked into
# the client bundle — it is NOT a secret. Do not put tokens/keys here.
#
# Set this to your deployed backend's base URL (no trailing slash). You can also
# override it per-deployment by defining VITE_API_URL in the Vercel project's
# Environment Variables (a real env var wins over this file at build time).
#
# ⚠️  Replace the host below with your actual Render backend URL before deploying.
VITE_API_URL=https://vivid-api.onrender.com
