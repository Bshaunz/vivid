# Frontend env (Vite). Copy to .env.local for dev (gitignored).
#
# Base URL of the FastAPI backend. In dev this defaults to http://localhost:8000
# automatically, so you only need to set it when:
#   - your backend runs on a different host/port, or
#   - you build for production (vite build / preview), where there is no dev
#     default and an unset value falls back to same-origin.
#
# Production (Vercel FE + Render BE): set this at build time to the Render URL,
# e.g. VITE_API_URL=https://vivid-api.onrender.com
VITE_API_URL=http://localhost:8000

# ── Supabase auth (PUBLIC keys — baked into the client bundle) ────────────────
# Set BOTH to enable the login gate + Bearer-token injection. Leave them UNSET
# for local dev against a backend running DEV_MODE=true (the app skips login and
# the backend uses its dev user). The anon key is publishable by design — RLS,
# not key secrecy, protects the data.
#   Supabase → Project Settings → API → Project URL  and  Project API keys (anon)
# VITE_SUPABASE_URL=https://<your-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
